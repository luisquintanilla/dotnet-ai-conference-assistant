@using ConferenceAssistant.Core.Models

<div class="poll-card">
    <h3>@Poll.Question</h3>
    <div class="poll-options">
        @foreach (var option in Poll.Options)
        {
            var isSelected = SelectedOption == option;
            <button class="poll-option @(isSelected ? "selected" : "") @(HasVoted ? "disabled" : "")"
                    disabled="@HasVoted"
                    @onclick="() => OnVote(option)">
                <span class="option-text">@option</span>
                @if (HasVoted && Results is not null && Results.TryGetValue(option, out var count))
                {
                    var total = Results.Values.Sum();
                    var pct = total > 0 ? (int)(100.0 * count / total) : 0;
                    <span class="option-bar" style="width: @(pct)%"></span>
                    <span class="option-pct">@pct%</span>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Poll Poll { get; set; } = default!;
    [Parameter] public Dictionary<string, int>? Results { get; set; }
    [Parameter] public EventCallback<string> OnVoteSubmitted { get; set; }

    private string? SelectedOption;
    private bool HasVoted;

    private async Task OnVote(string option)
    {
        if (HasVoted) return;
        SelectedOption = option;
        HasVoted = true;
        await OnVoteSubmitted.InvokeAsync(option);
    }
}

<style>
    .poll-card {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .poll-card h3 {
        margin: 0 0 1rem;
        font-size: 1.25rem;
    }

    .poll-options {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .poll-option {
        position: relative;
        padding: 1rem 1.25rem;
        background: rgba(255, 255, 255, 0.08);
        border: 2px solid rgba(255, 255, 255, 0.15);
        border-radius: 0.75rem;
        color: white;
        font-size: 1rem;
        cursor: pointer;
        text-align: left;
        transition: all 0.2s;
        overflow: hidden;
    }

    .poll-option:hover:not(.disabled) {
        border-color: #e94560;
        background: rgba(233, 69, 96, 0.15);
    }

    .poll-option.selected {
        border-color: #e94560;
        background: rgba(233, 69, 96, 0.2);
    }

    .poll-option.disabled {
        cursor: default;
    }

    .option-bar {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        background: rgba(233, 69, 96, 0.2);
        transition: width 0.5s ease;
        z-index: 0;
    }

    .option-text, .option-pct {
        position: relative;
        z-index: 1;
    }

    .option-pct {
        float: right;
        font-weight: 600;
        color: #e94560;
    }
</style>
