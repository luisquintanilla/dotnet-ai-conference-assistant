    .btn {
        padding: 0.6rem 1.25rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: white;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-back {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .btn-back:hover {
        border-color: rgba(255, 255, 255, 0.3);
        color: white;
    }

    .btn-create {
        background: #e94560;
        padding: 0.7rem 1.5rem;
    }

    .btn-create:hover {
        background: #d63851;
    }

    .btn-create:disabled {
        opacity: 0.5;
        cursor: default;
    }
</style>
