@page "/"
@layout ConferenceAssistant.Web.Components.Layout.HomeLayout
@using ConferenceAssistant.Core.Models
@using ConferenceAssistant.Core.Services
@inject ISessionService SessionService
@rendermode InteractiveServer

<PageTitle>Conference Pulse</PageTitle>

<div class="landing">
    <div class="landing-hero">
        <h1>🎯 Conference Pulse</h1>
        <p class="hero-subtitle">AI-Powered Conference Assistant</p>
        @if (session is not null)
        {
            <div class="session-info">
                <span class="session-title">@session.Title</span>
                <span class="status-indicator @session.Status.ToString().ToLower()">@session.Status</span>
            </div>
        }
    </div>
    <div class="landing-links">
        <a href="/presenter" class="landing-card">
            <span class="card-icon">🎤</span>
            <span class="card-title">Presenter Dashboard</span>
            <span class="card-desc">Control panel for the speaker</span>
        </a>
        <a href="/session/@sessionCode" class="landing-card">
            <span class="card-icon">📱</span>
            <span class="card-title">Join Session</span>
            <span class="card-desc">Audience participation view</span>
        </a>
        <a href="/display" class="landing-card">
            <span class="card-icon">🖥️</span>
            <span class="card-title">Projection Display</span>
            <span class="card-desc">Big screen visualization</span>
        </a>
    </div>
</div>

@code {
    private ConferenceSession? session;
    private string sessionCode = "DOTNETAI-CONF";

    protected override void OnInitialized()
    {
        session = SessionService.CurrentSession;
        if (session is not null)
        {
            sessionCode = session.Id;
        }
    }
}

<style>
    .landing {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        padding: 2rem;
    }

    .landing-hero {
        text-align: center;
        margin-bottom: 3rem;
    }

    .landing-hero h1 {
        font-size: 3.5rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        opacity: 0.6;
        margin-bottom: 1.5rem;
    }

    .session-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .session-title {
        font-size: 1rem;
        opacity: 0.8;
    }

    .status-indicator {
        padding: 0.2rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-indicator.setup {
        background: rgba(249, 199, 79, 0.2);
        color: #f9c74f;
    }

    .status-indicator.live {
        background: rgba(233, 69, 96, 0.25);
        color: #e94560;
        animation: pulse-glow 2s infinite;
    }

    .status-indicator.completed {
        background: rgba(78, 205, 196, 0.2);
        color: #4ecdc4;
    }

    @@keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 4px rgba(233, 69, 96, 0.3); }
        50% { box-shadow: 0 0 12px rgba(233, 69, 96, 0.6); }
    }

    .landing-links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .landing-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        text-decoration: none;
        color: white;
        width: 220px;
        transition: all 0.3s ease;
    }

    .landing-card:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #e94560;
        transform: translateY(-4px);
    }

    .card-icon {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .card-desc {
        font-size: 0.8rem;
        opacity: 0.6;
        text-align: center;
    }
</style>
