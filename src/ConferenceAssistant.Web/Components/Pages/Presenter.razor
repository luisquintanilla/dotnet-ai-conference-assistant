@page "/presenter"
@layout ConferenceAssistant.Web.Components.Layout.PresenterLayout
@using ConferenceAssistant.Core.Models
@using ConferenceAssistant.Core.Services
@using ConferenceAssistant.Ingestion.Services
@implements IDisposable
@inject ISessionService SessionService
@inject IPollService PollService
@inject IInsightService InsightService
@inject IQuestionService QuestionService
@inject ISemanticSearchService SemanticSearchService
@inject IInsightGenerationService InsightGenerationService
@rendermode InteractiveServer

<PageTitle>Presenter Dashboard</PageTitle>

<div class="presenter-page">
    @if (session is null)
    {
        <div class="no-session">
            <h2>No session loaded</h2>
            <p>Load a conference outline to get started.</p>
        </div>
    }
    else
    {
        <!-- Session Controls (top bar) -->
        <div class="session-bar">
            <div class="session-header">
                <h1>@session.Title</h1>
                <span class="status-badge @session.Status.ToString().ToLower()">@session.Status</span>
                <span class="record-count" title="Knowledge base records">📚 @knowledgeBaseCount records</span>
            </div>
            <div class="session-controls">
                @if (session.Status == SessionStatus.Setup)
                {
                    <button class="btn btn-primary" @onclick="StartSession">🚀 Go Live</button>
                }
                else if (session.Status == SessionStatus.Live)
                {
                    <button class="btn btn-danger" @onclick="EndSession">⏹ End Session</button>
                }
            </div>
        </div>

        <div class="dashboard-grid">
            <!-- Topic Navigation (left panel) -->
            <div class="panel topic-nav">
                <h2>Topics</h2>
                <div class="topic-list">
                    @foreach (var topic in session.Topics.OrderBy(t => t.Order))
                    {
                        <div class="topic-row @(topic.Status == TopicStatus.Active ? "active" : "")">
                            <TopicBadge Topic="@topic" />
                            @if (session.Status == SessionStatus.Live)
                            {
                                @if (topic.Status == TopicStatus.Upcoming)
                                {
                                    <button class="btn btn-sm" @onclick="() => ActivateTopic(topic.Id)">▶ Activate</button>
                                }
                                else if (topic.Status == TopicStatus.Active)
                                {
                                    <button class="btn btn-sm btn-complete" @onclick="() => CompleteTopic(topic.Id)">✓ Complete</button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Active Topic Panel (main area) -->
            <div class="panel main-panel" tabindex="0" @onkeydown="HandleSlideKeydown">
                @if (activeSlide is not null)
                {
                    <!-- SLIDE ZONE (top half, never scrolls) -->
                    <div class="slide-zone">
                        <div class="slide-previews">
                            <div class="slide-preview-current">
                                <SlideRenderer Slide="@activeSlide" Compact="true" />
                            </div>
                            @if (nextSlide is not null)
                            {
                                <div class="slide-preview-next">
                                    <span class="up-next-label">Up Next</span>
                                    <SlideRenderer Slide="@nextSlide" Compact="true" />
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(activeSlide.SpeakerNotes))
                        {
                            <div class="speaker-notes">
                                <span>🎤</span> @activeSlide.SpeakerNotes
                            </div>
                        }

                        <div class="slide-nav-controls">
                            <button class="btn btn-sm" @onclick="GoBackSlideAsync" disabled="@(SessionService.ActiveSlideIndex <= 0)">◀ Prev</button>
                            <span class="slide-progress">Slide @(SessionService.ActiveSlideIndex + 1) / @SessionService.TotalSlides</span>
                            <button class="btn btn-sm" @onclick="AdvanceSlideAsync" disabled="@(SessionService.ActiveSlideIndex >= SessionService.TotalSlides - 1)">Next ▶</button>
                        </div>
                    </div>
                }

                <!-- TOOLS ZONE (bottom half, tabbed) -->
                @if (activeTopic is not null)
                {
                    <div class="tools-zone">
                        <div class="tab-bar">
                            <button class="tab-btn @(activeTab == "polls" ? "active" : "")" @onclick='() => SetActiveTab("polls")'>
                                📊 Polls @if (activePoll?.Status == PollStatus.Active) {<span class="tab-badge live">LIVE</span>}
                            </button>
                            <button class="tab-btn @(activeTab == "qa" ? "active" : "")" @onclick='() => SetActiveTab("qa")'>
                                ❓ Q&amp;A @if (topicQuestions.Count > 0) {<span class="tab-badge">@topicQuestions.Count</span>}
                            </button>
                            <button class="tab-btn @(activeTab == "topic" ? "active" : "")" @onclick='() => SetActiveTab("topic")'>
                                📋 Topic
                            </button>
                        </div>

                        <div class="tab-content">
                            @if (activeTab == "polls")
                            {
                                @if (activePoll is null || activePoll.Status == PollStatus.Closed)
                                {
                                    @if (closedPoll is not null)
                                    {
                                        <div class="closed-poll-results">
                                            <h4>Last Poll Results: @closedPoll.Question</h4>
                                            <PollResultsChart Poll="@closedPoll" Results="@closedPollResults" />
                                        </div>
                                    }

                                    <div class="poll-actions">
                                        <button class="btn btn-outline" @onclick="AutoGeneratePoll">🤖 Auto-Generate Poll</button>

                                        @if (activeTopic.SuggestedPolls.Count > 0)
                                        {
                                            <div class="suggested-poll-picker">
                                                <select @bind="selectedSuggestedPollIndex">
                                                    <option value="-1">— Use Suggested Poll —</option>
                                                    @for (var i = 0; i < activeTopic.SuggestedPolls.Count; i++)
                                                    {
                                                        <option value="@i">@activeTopic.SuggestedPolls[i].Question</option>
                                                    }
                                                </select>
                                                <button class="btn btn-sm btn-primary"
                                                        disabled="@(selectedSuggestedPollIndex < 0)"
                                                        @onclick="LaunchSelectedSuggestedPoll">
                                                    Launch
                                                </button>
                                            </div>
                                        }

                                        <div class="custom-poll-form">
                                            <button class="btn btn-outline" @onclick="ToggleCustomPollForm">
                                                ✏️ Custom Poll
                                            </button>
                                            @if (showCustomPollForm)
                                            {
                                                <div class="custom-poll-inputs">
                                                    <input type="text" @bind="customPollQuestion" placeholder="Poll question..." />
                                                    @for (var i = 0; i < customPollOptions.Count; i++)
                                                    {
                                                        var index = i;
                                                        <div class="option-row">
                                                            <input type="text"
                                                                   value="@customPollOptions[index]"
                                                                   @onchange="(e) => UpdateCustomOption(index, e.Value?.ToString() ?? string.Empty)"
                                                                   placeholder="Option @(index + 1)..." />
                                                            @if (customPollOptions.Count > 2)
                                                            {
                                                                <button class="btn-icon" @onclick="() => RemoveCustomOption(index)">✕</button>
                                                            }
                                                        </div>
                                                    }
                                                    <div class="custom-poll-actions">
                                                        <button class="btn btn-sm" @onclick="AddCustomOption">+ Add Option</button>
                                                        <button class="btn btn-sm btn-primary"
                                                                disabled="@(!IsCustomPollValid)"
                                                                @onclick="LaunchCustomPoll">
                                                            🚀 Create &amp; Go Live
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="active-poll">
                                        <h4>@activePoll.Question</h4>
                                        <div class="poll-options-display">
                                            @foreach (var option in activePoll.Options)
                                            {
                                                var count = activePollResults?.GetValueOrDefault(option, 0) ?? 0;
                                                var total = activePollResults?.Values.Sum() ?? 0;
                                                var pct = total > 0 ? (int)(100.0 * count / total) : 0;
                                                <div class="poll-option-bar">
                                                    <div class="poll-option-fill" style="width: @(pct)%"></div>
                                                    <span class="poll-option-label">@option</span>
                                                    <span class="poll-option-count">@count (@(pct)%)</span>
                                                </div>
                                            }
                                        </div>
                                        @if (activePoll.Status == PollStatus.Draft)
                                        {
                                            <button class="btn btn-primary" @onclick="() => ActivatePollAsync(activePoll.Id)">📡 Go Live</button>
                                        }
                                        else if (activePoll.Status == PollStatus.Active)
                                        {
                                            <button class="btn btn-danger" @onclick="() => ClosePollAsync(activePoll.Id)">🔒 Close Poll</button>
                                        }
                                    </div>
                                }
                            }
                            else if (activeTab == "qa")
                            {
                                @if (topicQuestions.Count == 0)
                                {
                                    <p class="muted">No questions yet.</p>
                                }
                                else
                                {
                                    @foreach (var q in topicQuestions.OrderByDescending(q => q.Upvotes))
                                    {
                                        <div class="question-item">
                                            <div class="question-header">
                                                <span class="upvote-count">👍 @q.Upvotes</span>
                                                <span class="question-text">@q.Text</span>
                                            </div>
                                            @if (q.Answers.Count > 0)
                                            {
                                                @foreach (var answer in q.Answers)
                                                {
                                                    <div class="question-answer @(answer.IsAiGenerated ? "ai-answer" : "")">
                                                        @if (answer.IsAiGenerated)
                                                        {
                                                            <span class="ai-badge">🤖 AI</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="human-badge">💬 @answer.AuthorLabel</span>
                                                        }
                                                        <strong>A:</strong> @answer.Text
                                                    </div>
                                                }
                                            }
                                            @if (answeringQuestionId == q.Id)
                                            {
                                                <div class="answer-form">
                                                    <input type="text" @bind="answerText" placeholder="Type your answer..." />
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SubmitAnswer(q.Id)">Submit</button>
                                                    <button class="btn btn-sm" @onclick="CancelAnswer">Cancel</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm" @onclick="() => StartAnswering(q.Id)">💬 Add Answer</button>
                                            }
                                        </div>
                                    }
                                }
                            }
                            else if (activeTab == "topic")
                            {
                                <h2>🎯 @activeTopic.Title</h2>
                                @if (!string.IsNullOrWhiteSpace(activeTopic.Description))
                                {
                                    <p class="topic-description">@activeTopic.Description</p>
                                }
                                @if (activeTopic.TalkingPoints.Count > 0)
                                {
                                    <ul class="talking-points">
                                        @foreach (var point in activeTopic.TalkingPoints)
                                        {
                                            <li>@point</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    </div>
                }
                else if (activeSlide is null)
                {
                    <div class="no-active-topic">
                        <p>Select a topic to activate from the panel on the left.</p>
                    </div>
                }
            </div>

            <!-- Insights Panel (right side) -->
            <div class="panel insights-panel">
                <h2>💡 Insights</h2>
                @if (activeTopic is not null)
                {
                    <button class="btn btn-sm btn-insight" @onclick="GenerateInsightsManually" disabled="@isGeneratingInsights">
                        @if (isGeneratingInsights)
                        {
                            <span>⏳ Generating...</span>
                        }
                        else
                        {
                            <span>🔄 Generate Insights</span>
                        }
                    </button>
                }
                @if (topicInsights.Count == 0)
                {
                    <p class="muted">No insights yet for this topic.</p>
                }
                else
                {
                    @foreach (var insight in topicInsights)
                    {
                        <InsightCard Insight="@insight" />
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private ConferenceSession? session;
    private SessionTopic? activeTopic;
    private Poll? activePoll;
    private Dictionary<string, int>? activePollResults;
    private Poll? closedPoll;
    private Dictionary<string, int>? closedPollResults;
    private IReadOnlyList<Insight> topicInsights = [];
    private IReadOnlyList<AudienceQuestion> topicQuestions = [];
    private int knowledgeBaseCount;

    // Suggested poll selection
    private int selectedSuggestedPollIndex = -1;

    // Custom poll form
    private bool showCustomPollForm;
    private string customPollQuestion = "";
    private List<string> customPollOptions = ["", ""];

    // Question answering
    private string? answeringQuestionId;
    private string answerText = "";

    // Insight generation
    private bool isGeneratingInsights;

    // Tab state for tools zone
    private string activeTab = "polls";

    // Slide navigation
    private Slide? activeSlide;
    private Slide? nextSlide;
    private Action<Slide>? onSlideChanged;

    // Event handler references for cleanup
    private Action<PollResponse>? onResponseReceived;
    private Action<Poll>? onPollActivated;
    private Action<Poll>? onPollClosed;
    private Action<AudienceQuestion>? onQuestionReceived;
    private Action<AudienceQuestion>? onQuestionAnswered;
    private Action<AudienceQuestion>? onQuestionUpvoted;
    private Action<Insight>? onInsightGenerated;
    private Timer? _knowledgeBaseTimer;

    protected override async Task OnInitializedAsync()
    {
        session = SessionService.CurrentSession;
        RefreshState();

        try { knowledgeBaseCount = await SemanticSearchService.GetRecordCountAsync(); }
        catch { knowledgeBaseCount = 0; }

        onResponseReceived = _ => InvokeAsync(() => { RefreshPollResults(); StateHasChanged(); });
        onPollActivated = _ => InvokeAsync(() => { RefreshState(); StateHasChanged(); });
        onPollClosed = _ => InvokeAsync(() => { RefreshState(); RefreshKnowledgeBaseCount(); StateHasChanged(); });
        onQuestionReceived = _ => InvokeAsync(() => { RefreshQuestions(); RefreshKnowledgeBaseCount(); StateHasChanged(); });
        onQuestionAnswered = _ => InvokeAsync(() => { RefreshQuestions(); RefreshKnowledgeBaseCount(); StateHasChanged(); });
        onQuestionUpvoted = _ => InvokeAsync(() => { RefreshQuestions(); StateHasChanged(); });
        onInsightGenerated = _ => InvokeAsync(() => { RefreshInsights(); RefreshKnowledgeBaseCount(); StateHasChanged(); });
        onSlideChanged = _ => InvokeAsync(() => { activeSlide = SessionService.ActiveSlide; nextSlide = SessionService.GetNextSlide(); StateHasChanged(); });

        PollService.ResponseReceived += onResponseReceived;
        PollService.PollActivated += onPollActivated;
        PollService.PollClosed += onPollClosed;
        QuestionService.QuestionReceived += onQuestionReceived;
        QuestionService.QuestionAnswered += onQuestionAnswered;
        QuestionService.QuestionUpvoted += onQuestionUpvoted;
        InsightService.InsightGenerated += onInsightGenerated;
        SessionService.SlideChanged += onSlideChanged;

        // Periodic refresh of knowledge base count (catches background ingestion)
        _knowledgeBaseTimer = new Timer(_ =>
            InvokeAsync(() => { RefreshKnowledgeBaseCount(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    public void Dispose()
    {
        _knowledgeBaseTimer?.Dispose();
        PollService.ResponseReceived -= onResponseReceived;
        PollService.PollActivated -= onPollActivated;
        PollService.PollClosed -= onPollClosed;
        QuestionService.QuestionReceived -= onQuestionReceived;
        QuestionService.QuestionAnswered -= onQuestionAnswered;
        QuestionService.QuestionUpvoted -= onQuestionUpvoted;
        InsightService.InsightGenerated -= onInsightGenerated;
        SessionService.SlideChanged -= onSlideChanged;
    }

    private void RefreshState()
    {
        session = SessionService.CurrentSession;
        activeTopic = SessionService.GetActiveTopic();
        activeSlide = SessionService.ActiveSlide;
        nextSlide = SessionService.GetNextSlide();

        var previousPoll = activePoll;
        activePoll = PollService.GetActivePoll();
        RefreshPollResults();

        // Track the last closed poll for displaying final results
        if (previousPoll is not null && previousPoll.Status != PollStatus.Closed && activePoll is null)
        {
            closedPoll = previousPoll;
            closedPollResults = PollService.GetPollResults(previousPoll.Id);
        }

        if (activeTopic is not null)
        {
            topicInsights = InsightService.GetInsightsForTopic(activeTopic.Id);
            topicQuestions = QuestionService.GetQuestionsForTopic(activeTopic.Id);

            // Track most recently closed poll for this topic
            var topicPolls = PollService.GetPollsForTopic(activeTopic.Id);
            var lastClosed = topicPolls.LastOrDefault(p => p.Status == PollStatus.Closed);
            if (lastClosed is not null && activePoll is null)
            {
                closedPoll = lastClosed;
                closedPollResults = PollService.GetPollResults(lastClosed.Id);
            }
        }
        else
        {
            topicInsights = [];
            topicQuestions = [];
        }

        ResetPollForm();
    }

    private void RefreshPollResults()
    {
        if (activePoll is not null)
            activePollResults = PollService.GetPollResults(activePoll.Id);
    }

    private void RefreshQuestions()
    {
        if (activeTopic is not null)
            topicQuestions = QuestionService.GetQuestionsForTopic(activeTopic.Id);
    }

    private void RefreshInsights()
    {
        if (activeTopic is not null)
            topicInsights = InsightService.GetInsightsForTopic(activeTopic.Id);
    }

    private async void RefreshKnowledgeBaseCount()
    {
        try { knowledgeBaseCount = await SemanticSearchService.GetRecordCountAsync(); }
        catch { /* swallow */ }
    }

    private async Task StartSession()
    {
        await SessionService.StartSessionAsync();
        RefreshState();
    }

    private async Task EndSession()
    {
        await SessionService.EndSessionAsync();
        RefreshState();
    }

    private async Task ActivateTopic(string topicId)
    {
        await SessionService.ActivateTopicAsync(topicId);
        closedPoll = null;
        closedPollResults = null;
        RefreshState();
    }

    private async Task CompleteTopic(string topicId)
    {
        await SessionService.CompleteTopicAsync(topicId);
        RefreshState();
    }

    // Poll actions

    private async Task AutoGeneratePoll()
    {
        if (activeTopic is null) return;
        // Placeholder: use first suggested poll if available, otherwise no-op
        var suggested = activeTopic.SuggestedPolls.FirstOrDefault();
        if (suggested is null) return;
        var poll = await PollService.CreatePollAsync(activeTopic.Id, suggested.Question, suggested.Options, PollSource.Generated);
        await PollService.ActivatePollAsync(poll.Id);
        RefreshState();
    }

    private async Task LaunchSelectedSuggestedPoll()
    {
        if (activeTopic is null || selectedSuggestedPollIndex < 0) return;
        var sp = activeTopic.SuggestedPolls[selectedSuggestedPollIndex];
        var poll = await PollService.CreatePollAsync(activeTopic.Id, sp.Question, sp.Options, PollSource.Suggested);
        await PollService.ActivatePollAsync(poll.Id);
        selectedSuggestedPollIndex = -1;
        RefreshState();
    }

    private void ToggleCustomPollForm()
    {
        showCustomPollForm = !showCustomPollForm;
        if (showCustomPollForm)
        {
            customPollQuestion = "";
            customPollOptions = ["", ""];
        }
    }

    private void UpdateCustomOption(int index, string value)
    {
        if (index >= 0 && index < customPollOptions.Count)
            customPollOptions[index] = value;
    }

    private void AddCustomOption() => customPollOptions.Add("");

    private void RemoveCustomOption(int index)
    {
        if (index >= 0 && index < customPollOptions.Count && customPollOptions.Count > 2)
            customPollOptions.RemoveAt(index);
    }

    private bool IsCustomPollValid =>
        !string.IsNullOrWhiteSpace(customPollQuestion)
        && customPollOptions.Count(o => !string.IsNullOrWhiteSpace(o)) >= 2;

    private async Task LaunchCustomPoll()
    {
        if (activeTopic is null || !IsCustomPollValid) return;
        var options = customPollOptions.Where(o => !string.IsNullOrWhiteSpace(o)).Select(o => o.Trim()).ToList();
        var poll = await PollService.CreatePollAsync(activeTopic.Id, customPollQuestion.Trim(), options, PollSource.Custom);
        await PollService.ActivatePollAsync(poll.Id);
        showCustomPollForm = false;
        RefreshState();
    }

    private async Task ActivatePollAsync(string pollId)
    {
        await PollService.ActivatePollAsync(pollId);
        RefreshState();
    }

    private async Task ClosePollAsync(string pollId)
    {
        await PollService.ClosePollAsync(pollId);
        RefreshState();
    }

    private void ResetPollForm()
    {
        selectedSuggestedPollIndex = -1;
    }

    // Question answering

    private void StartAnswering(string questionId)
    {
        answeringQuestionId = questionId;
        answerText = "";
    }

    private void CancelAnswer()
    {
        answeringQuestionId = null;
        answerText = "";
    }

    private async Task SubmitAnswer(string questionId)
    {
        if (string.IsNullOrWhiteSpace(answerText)) return;
        await QuestionService.AnswerQuestionAsync(questionId, answerText.Trim());
        answeringQuestionId = null;
        answerText = "";

        if (activeTopic is not null)
            topicQuestions = QuestionService.GetQuestionsForTopic(activeTopic.Id);
    }

    private async Task GenerateInsightsManually()
    {
        if (activeTopic is null) return;
        isGeneratingInsights = true;
        StateHasChanged();

        try
        {
            await InsightGenerationService.GenerateTopicInsightsAsync(activeTopic.Id);

            // Also generate poll insights for any closed polls in this topic
            var closedPolls = PollService.GetPollsForTopic(activeTopic.Id)
                .Where(p => p.Status == PollStatus.Closed);
            foreach (var p in closedPolls)
            {
                await InsightGenerationService.GeneratePollInsightsAsync(p.Id);
            }
        }
        finally
        {
            isGeneratingInsights = false;
            RefreshInsights();
            StateHasChanged();
        }
    }

    // Slide navigation

    private void SetActiveTab(string tab) { activeTab = tab; }

    private async Task AdvanceSlideAsync()
    {
        await SessionService.AdvanceSlideAsync();
        RefreshState();
    }

    private async Task GoBackSlideAsync()
    {
        await SessionService.GoBackSlideAsync();
        RefreshState();
    }

    private async Task HandleSlideKeydown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowRight" or " ")
        {
            await AdvanceSlideAsync();
        }
        else if (e.Key is "ArrowLeft")
        {
            await GoBackSlideAsync();
        }
    }
}

<style>
    .question-answer.ai-answer {
        background: rgba(100, 100, 255, 0.1);
        border-left: 3px solid rgba(100, 100, 255, 0.5);
        padding: 0.5rem;
        border-radius: 0.25rem;
        margin-top: 0.25rem;
    }

    .ai-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(100, 100, 255, 0.2);
        color: #aab0ff;
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
        margin-right: 0.4rem;
    }

    .btn-override {
        font-size: 0.75rem;
        margin-top: 0.25rem;
        opacity: 0.6;
        border: 1px dashed rgba(255, 255, 255, 0.2);
        background: none;
        color: white;
        padding: 0.2rem 0.5rem;
        border-radius: 0.25rem;
        cursor: pointer;
    }

    .btn-override:hover {
        opacity: 1;
        border-color: #e94560;
    }

    .human-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(78, 205, 196, 0.2);
        color: #4ecdc4;
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
        margin-right: 0.4rem;
    }

    .btn-insight {
        font-size: 0.8rem;
        margin-bottom: 0.75rem;
        border: 1px solid rgba(255, 200, 0, 0.4);
        background: rgba(255, 200, 0, 0.1);
        color: #ffc800;
        padding: 0.3rem 0.75rem;
        border-radius: 0.5rem;
        cursor: pointer;
    }

    .btn-insight:hover:not(:disabled) {
        background: rgba(255, 200, 0, 0.2);
        border-color: #ffc800;
    }

    .btn-insight:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
